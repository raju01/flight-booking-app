# AirLabs API key (https://airlabs.co) for live flight status. Without it the status page shows sample data.
AIRLABS_API_KEY=

# SerpApi key (https://serpapi.com) for live Google Flights fares (covers Indian airlines).
SERPAPI_API_KEY=

# Affiliate tracking is ON by default. Set to false (or 0, off, no) to send everyone to the plain merchant
# links. While a channel is still pending, leaving it on is safe: the server checks the tracker accepts each
# link first and otherwise uses the plain merchant link, then starts tracking by itself once approved.
# AFFILIATE_ENABLED=false

# Cuelinks channel id. In the Cuelinks dashboard, generate any link and copy the number after cid=.
# Book on MakeMyTrip and Book on redBus then go through https://linksredirect.com so the click can earn.
# Adding a bank account does not do this by itself.
CUELINKS_CHANNEL_ID=

# Optional full tracker. Use this only if it is not the standard Cuelinks cid link above.
# {url} is the merchant address. Example:
# AFFILIATE_LINK_TEMPLATE=https://linksredirect.com/?cid=12345&source=linkkit&url={url}

# Optional flight partner that completes the booking (MakeMyTrip, Cleartrip, Ixigo, etc.).
# Placeholders: {from} {to} {date} {airline}. When both are set, this becomes the main Book button.
# NEXT_PUBLIC_FLIGHT_PARTNER_NAME=MakeMyTrip
# NEXT_PUBLIC_FLIGHT_PARTNER_URL=https://example.com/flights?from={from}&to={to}&date={date}

# Optional bus partner. Defaults to a redBus route page.
# Placeholders: {from} {to} {fromSlug} {toSlug} {date}
# NEXT_PUBLIC_BUS_PARTNER_NAME=redBus
# NEXT_PUBLIC_BUS_PARTNER_URL=https://www.redbus.in/bus-tickets/{fromSlug}-to-{toSlug}

# Optional: shown on the About and Privacy pages.
NEXT_PUBLIC_CONTACT_EMAIL=

# Public address of the site, used in the sitemap, canonical links and social previews.
# NEXT_PUBLIC_SITE_URL=https://www.example.com

# Generated sample fares are for development only. By default they show everywhere except production, where
# a failed live lookup shows "temporarily unavailable" instead. Set true to allow samples on a live site
# (not recommended), or false to turn them off locally too.
# ALLOW_SAMPLE_DATA=false
